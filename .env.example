# General
PROJECT_NAME=bigdata_github_events
LOCAL_RAW_DIR=data/raw
LOCAL_PROCESSED_DIR=data/processed

# GH Archive
GHARCHIVE_BASE_URL=https://data.gharchive.org
DEFAULT_DATE=2026-06-01
DEFAULT_HOUR=0

# Google Cloud Storage - opcional para despliegue en GCP
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
USE_GCS=false

# MongoDB
MONGO_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
MONGO_DATABASE=github_events
MONGO_COLLECTION=github_events_raw

# Cassandra
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=github_events

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Dashboard
STREAMLIT_SERVER_PORT=8501
